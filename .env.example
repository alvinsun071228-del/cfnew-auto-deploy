# ===== Cloudflare 账号 / Cloudflare account =====
# 账号 ID，见 Cloudflare 面板右侧 / Account ID, see the right sidebar of the CF dashboard
CF_ACCOUNT_ID=

# 一个受限的 API Token（推荐）或 Global API Key
# A scoped API Token (recommended) or a Global API Key
# Token 至少需要：Workers Scripts Write + Workers KV Storage Write（账号级）
# Token needs at least: Workers Scripts Write + Workers KV Storage Write (account scope)
CF_API_TOKEN=

# ===== Worker 配置 / Worker config =====
# KV 命名空间 ID（绑定变量名 C）/ KV namespace ID (bound as variable "C")
KV_NAMESPACE=

# Worker 脚本名，默认 cfnew-terminal / Worker script name, defaults to cfnew-terminal
WORKER_NAME=cfnew-terminal

# 你的 UUID（用于访问面板和订阅）/ your UUID (used for the panel & subscription)
UUID=
